{
  "name": "claude-companion",
  "version": "0.0.1",
  "description": "A chief of staff for your engineering work, built on Claude Code",
  "type": "module",
  "license": "MIT",
  "bin": {
    "companion": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --target node20 --clean",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
